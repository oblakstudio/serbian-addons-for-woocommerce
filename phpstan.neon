parameters:
  level: 5
  paths:
    - config
    - lib
    - woocommerce
    - serbian-addons-for-woocommerce.php
  excludePaths:
    analyse:
      - lib/QR/*
  bootstrapFiles:
    - constants.php
    - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
  ignoreErrors:
    # XWP_Asset_Bundle::offsetGet() is documented as non-null but returns null for unknown files.
    -
      identifier: nullsafe.neverNull
      paths:
        - lib/Gateway/Gateway_Payment_Slip.php
    -
      identifier: nullCoalesce.expr
      paths:
        - lib/Gateway/Gateway_Payment_Slip.php
